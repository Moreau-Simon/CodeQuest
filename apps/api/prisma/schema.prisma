// CodeQuest — schéma Prisma.
// Source de vérité : specs/001-codequest-platform/data-model.md
// Toute évolution passe par une migration versionnée (versioning.md §4).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext]
}

// ---------------------------------------------------------------------------
// Enumerations (Phase 2)
// ---------------------------------------------------------------------------

enum UserStatus {
  pending
  active
  suspended
  deleted

  @@map("user_status")
}

enum RoleKey {
  player
  moderator
  admin

  @@map("role_key")
}

/// Rôle d'un membre d'équipe (FR-055, FR-058).
enum TeamMemberRole {
  captain
  member

  @@map("team_member_role")
}

/// Raisons des mouvements de la monnaie virtuelle (FR-072, §7 data-model).
enum TransactionReason {
  challenge_reward
  record_bonus
  event_reward
  boss_reward
  badge
  achievement
  streak
  hint_purchase
  potion_purchase
  cosmetic_purchase
  admin_adjustment
  refund

  @@map("transaction_reason")
}

/// Nature d'un objet de boutique : seuls les objets non compétitifs sont
/// autorisés (FR-074).
enum ShopItemKind {
  hint
  potion
  avatar
  title
  editor_theme
  early_access

  @@map("shop_item_kind")
}

// ---------------------------------------------------------------------------
// 1. Identité et accès
// ---------------------------------------------------------------------------

model User {
  id                String     @id @db.Uuid
  email             String     @unique @db.Citext
  pseudonym         String     @unique @db.Citext
  passwordHash      String     @map("password_hash")
  emailVerifiedAt   DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  status            UserStatus @default(pending)
  preferredLanguage String     @default("python") @map("preferred_language")
  avatarKey         String?    @map("avatar_key")
  level             Int        @default(1)
  xp                Int        @default(0)
  preferences       Json       @default("{}")
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?  @map("deleted_at") @db.Timestamptz(6)

  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  pushSubscriptions   PushSubscription[]
  roles               UserRole[]
  grantedRoles        UserRole[]         @relation("UserRoleGrantedBy")
  auditLogs           AuditLog[]         @relation("AuditActor")
  settingsUpdated     PlatformSetting[]  @relation("PlatformSettingUpdatedBy")
  createdChallenges   Challenge[]        @relation("ChallengeCreatedBy")
  challengeVersions   ChallengeVersion[] @relation("ChallengeVersionCreatedBy")
  submissions         Submission[]
  attempts            ChallengeAttempt[]
  lessonProgress      LessonProgress[]
  loreProgress        LoreProgress[]
  captainedTeams      Team[]                   @relation("TeamCaptain")
  teamMemberships     TeamMember[]
  invitedToTeams      TeamInvitation[]         @relation("TeamInvitationInvitedUser")
  createdInvitations  TeamInvitation[]         @relation("TeamInvitationCreator")
  officialDesignations TeamOfficialSubmission[] @relation("OfficialSubmissionDesignator")
  contributionEvents  ContributionEvent[]
  contributionScores  ContributionScore[]
  createdEvents       Event[]                  @relation("EventCreatedBy")
  wallet              Wallet?
  inventory           Inventory[]
  hintPurchases       HintPurchase[]
  badges              UserBadge[]
  createdTransactions Transaction[]            @relation("TransactionCreatedBy")

  @@map("users")
}

model Session {
  id               String    @id @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  tokenFamilyId    String    @map("token_family_id") @db.Uuid
  rotatedFrom      String?   @map("rotated_from") @db.Uuid
  userAgent        String?   @map("user_agent")
  ipPrefix         String?   @map("ip_prefix")
  lastUsedAt       DateTime  @map("last_used_at") @db.Timestamptz(6)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason    String?   @map("revoked_reason")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  rotatedFromLink  Session?  @relation("SessionRotation", fields: [rotatedFrom], references: [id], onDelete: SetNull)
  derivedSessions  Session[] @relation("SessionRotation")

  @@index([userId])
  @@index([tokenFamilyId])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model PushSubscription {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  endpoint  String    @unique
  keys      Json
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// ---------------------------------------------------------------------------
// RBAC (FR-018 → FR-020)
// ---------------------------------------------------------------------------

model Role {
  id        String   @id @db.Uuid
  key       RoleKey  @unique
  label     String
  isGlobal  Boolean  @default(true) @map("is_global")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id        String   @id @db.Uuid
  key       String   @unique
  label     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  grantedBy String?  @map("granted_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role    Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  grantor User? @relation("UserRoleGrantedBy", fields: [grantedBy], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

// ---------------------------------------------------------------------------
// Audit et réglages de plateforme
// ---------------------------------------------------------------------------

/// Journal append-only : les triggers de la migration initiale refusent
/// UPDATE et DELETE (FR-089).
model AuditLog {
  id         String   @id @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  targetType String   @map("target_type")
  targetId   String?  @map("target_id")
  metadata   Json     @default("{}")
  ipPrefix   String?  @map("ip_prefix")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_logs")
}

model PlatformSetting {
  key       String   @id
  value     Json
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  updater User? @relation("PlatformSettingUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@map("platform_settings")
}

// ---------------------------------------------------------------------------
// 2. Contenu pédagogique et défis (US2)
// ---------------------------------------------------------------------------

enum ChallengeType {
  sorting
  debugging
  decryption
  steganography
  qr_code

  @@map("challenge_type")
}

enum ChallengeStatus {
  draft
  validating
  published
  archived

  @@map("challenge_status")
}

enum SubmissionStatus {
  pending
  running
  passed
  failed
  error
  timeout
  rejected

  @@map("submission_status")
}

enum SubjectType {
  player
  team

  @@map("subject_type")
}

/// Nature d'un événement de contribution individuelle (FR-059). Les lignes
/// conservées et les réussites ont un poids plein, l'assistance un poids réduit.
enum ContributionEventKind {
  kept_line
  success
  assistance

  @@map("contribution_event_kind")
}

/// Portée d'un classement (FR-045). `global` utilise l'UUID sentinelle
/// `00000000-0000-0000-0000-000000000000` comme `scope_id` : cela évite les
/// doublons d'unicité que PostgreSQL autoriserait avec `NULL`.
enum LeaderboardScopeType {
  global
  theme
  season
  event
  team

  @@map("leaderboard_scope_type")
}

/// Statut d'un signalement de message (FR-094, data-model.md §8).
enum ReportStatus {
  open
  reviewed
  dismissed

  @@map("report_status")
}

/// Événements (US9). Le cycle de vie est draft → scheduled → open → finished →
/// archived ; un événement terminé ne rouvre pas (data-model.md §5).
enum EventStatus {
  draft
  scheduled
  open
  finished
  archived

  @@map("event_status")
}

enum EventType {
  standard
  battle_royale

  @@map("event_type")
}

/// Thématique du catalogue (FR-021). Le lien vers le lore est ajouté avec
/// l'histoire « Explorer le lore » ; il reste nul tant que la table n'existe pas.
model Theme {
  id                  String   @id @db.Uuid
  slug                String   @unique
  name                String
  loreRegionChapterId String?  @map("lore_region_chapter_id") @db.Uuid
  sortOrder           Int      @default(0) @map("sort_order")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  challenges Challenge[]
  lessons    Lesson[]

  @@map("themes")
}

/// Défi et métadonnées de scoring (T072, FR-030 → FR-032). Les tests et la
/// solution de référence vivent dans `challenge_versions`, chiffrés.
model Challenge {
  id             String          @id @db.Uuid
  themeId        String          @map("theme_id") @db.Uuid
  type           ChallengeType
  difficulty     Int             @db.SmallInt
  title          String
  statementMd    String          @map("statement_md")
  languages      String[]
  basePoints     Int             @default(100) @map("base_points")
  perfMax        Int             @default(0) @map("perf_max")
  tOptMs         Int             @map("t_opt_ms")
  tMaxMs         Int             @map("t_max_ms")
  /// Défi de débogage : code bogué montré au joueur, jamais la correction (FR-037).
  buggyCode        String? @map("buggy_code")
  /// Limite de lignes modifiées conservant le bonus temps (FR-038, A5).
  maxModifiedLines Int?    @map("max_modified_lines")
  /// Défi de décryptage : chiffrement et référence de graine (jamais la graine, FR-040).
  cipher           String?
  keySeedRef       String? @map("key_seed_ref")
  status         ChallengeStatus @default(draft)
  isEventOnly    Boolean         @default(false) @map("is_event_only")
  isBossPhase    Boolean         @default(false) @map("is_boss_phase")
  currentVersion Int             @default(1) @map("current_version")
  createdBy      String?         @map("created_by") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  theme         Theme                  @relation(fields: [themeId], references: [id], onDelete: Restrict)
  author        User?                  @relation("ChallengeCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  versions      ChallengeVersion[]
  submissions    Submission[]
  attempts       ChallengeAttempt[]
  bestScores    BestScore[]
  officialTeamSubmissions TeamOfficialSubmission[]
  collaborativeDocuments  CollaborativeDocument[]
  contributionEvents      ContributionEvent[]
  eventLinks              EventChallenge[]
  bossPhases              BossPhase[]
  prerequisites ChallengePrerequisite[] @relation("ChallengePrerequisites")
  requiredFor   ChallengePrerequisite[] @relation("ChallengePrerequisiteRequirements")
  hints         ChallengeHint[]
  hintPurchases HintPurchase[]

  @@index([themeId])
  @@index([status])
  @@map("challenges")
}

/// Version immuable d'un défi publié (FR-087). `tests_encrypted` et
/// `reference_solution_encrypted` ne quittent jamais l'API/le runner.
model ChallengeVersion {
  id                         String   @id @db.Uuid
  challengeId                String   @map("challenge_id") @db.Uuid
  version                    Int
  statementSnapshot          String   @map("statement_snapshot")
  testsEncrypted             Bytes?   @map("tests_encrypted")
  referenceSolutionEncrypted Bytes?   @map("reference_solution_encrypted")
  keyId                      String?  @map("key_id")
  createdBy                  String?  @map("created_by") @db.Uuid
  createdAt                  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  challenge   Challenge    @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  author      User?        @relation("ChallengeVersionCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  submissions Submission[]

  @@unique([challengeId, version])
  @@index([challengeId])
  @@map("challenge_versions")
}

/// Soumission d'un joueur (T073, FR-033, FR-035). `team_id` et `event_id`
/// restent des scalaires jusqu'aux histoires équipes/événements.
model Submission {
  id                 String           @id @db.Uuid
  challengeId        String           @map("challenge_id") @db.Uuid
  challengeVersionId String           @map("challenge_version_id") @db.Uuid
  userId             String           @map("user_id") @db.Uuid
  teamId             String?          @map("team_id") @db.Uuid
  eventId            String?          @map("event_id") @db.Uuid
  bossPhaseId        String?          @map("boss_phase_id") @db.Uuid
  language           String
  code               String
  status             SubmissionStatus @default(pending)
  cpuTimesMs         Int[]            @map("cpu_times_ms")
  cpuTimeMedianMs    Int?             @map("cpu_time_median_ms")
  testsPassed        Int?             @map("tests_passed")
  testsTotal         Int?             @map("tests_total")
  score              Decimal?         @db.Decimal(12, 2)
  verdictReason      String?          @map("verdict_reason")
  attemptNo          Int              @default(1) @map("attempt_no")
  isOfficial         Boolean          @default(false) @map("is_official")
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  startedAt          DateTime?        @map("started_at") @db.Timestamptz(6)
  finishedAt         DateTime?        @map("finished_at") @db.Timestamptz(6)
  /// Déclenchement explicite de l'essai (A5) : jamais l'ouverture de la page.
  attemptId          String?          @map("attempt_id") @db.Uuid
  modifiedLines      Int?             @map("modified_lines")
  hintsUsed          Int              @default(0) @map("hints_used")
  verdictAt          DateTime?        @map("verdict_at") @db.Timestamptz(6)

  challenge Challenge        @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  version   ChallengeVersion @relation(fields: [challengeVersionId], references: [id], onDelete: Restrict)
  user      User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  attempt   ChallengeAttempt? @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  event     Event?            @relation(fields: [eventId], references: [id], onDelete: SetNull)
  bossPhase BossPhase?        @relation(fields: [bossPhaseId], references: [id], onDelete: SetNull)
  bestScores BestScore[]
  /// D4 : `TeamOfficialSubmission` est la source de vérité de la désignation ;
  /// ce booléen en est le miroir, maintenu dans la même transaction.
  officialTeamSubmissions TeamOfficialSubmission[] @relation("OfficialTeamSubmission")
  contributionEvents      ContributionEvent[]      @relation("ContributionSubmission")

  @@index([challengeId, score(sort: Desc), createdAt(sort: Asc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([eventId, userId])
  @@index([teamId, challengeId])
  @@map("submissions")
}

/// Essai explicite d'un joueur sur un défi chronométré (FR-039, FR-062, A5).
/// Une seule tentative par `(challenge, joueur)` est autorisée en v1.
model ChallengeAttempt {
  id            String    @id @db.Uuid
  challengeId   String    @map("challenge_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  startedAt     DateTime  @map("started_at") @db.Timestamptz(6)
  expiredAt     DateTime  @map("expired_at") @db.Timestamptz(6)
  verdictAt     DateTime? @map("verdict_at") @db.Timestamptz(6)
  hintsUsed     Int       @default(0) @map("hints_used")
  modifiedLines Int?      @map("modified_lines")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  challenge  Challenge    @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  submissions Submission[]

  @@unique([challengeId, userId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("challenge_attempts")
}

/// Meilleur score conservé par sujet (T073, FR-033). Le score d'équipe est la
/// soumission officielle unique du capitaine, recalculée à la désignation.
model BestScore {
  id           String      @id @db.Uuid
  challengeId  String      @map("challenge_id") @db.Uuid
  subjectType  SubjectType @map("subject_type")
  subjectId    String      @map("subject_id") @db.Uuid
  score        Decimal     @db.Decimal(12, 2)
  /// Une soumission peut être à la fois le meilleur score individuel de son
  /// auteur ET la soumission officielle retenue par son équipe : l'unicité sur
  /// `submission_id` est donc volontairement levée (US8).
  submissionId String      @map("submission_id") @db.Uuid
  achievedAt   DateTime    @default(now()) @map("achieved_at") @db.Timestamptz(6)

  challenge  Challenge  @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([challengeId, subjectType, subjectId])
  @@index([submissionId])
  @@index([subjectType, subjectId])
  @@map("best_scores")
}

// ---------------------------------------------------------------------------
// Classements (US3)
// ---------------------------------------------------------------------------

/// Saison de compétition (FR-045) : fenêtre temporelle d'une portée de
/// classement. Les saisons ne se chevauchent pas (vérifié par l'API).
model Season {
  id        String   @id @db.Uuid
  name      String
  slug      String   @unique
  startsAt  DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt    DateTime @map("ends_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("seasons")
}

/// Miroir durable des classements (FR-049). Redis ZSET est la lecture rapide ;
/// cette table est reconstruite périodiquement depuis `best_scores` et sert
/// de source de vérité pour vérifier l'identité des classements (SC-009).
model LeaderboardEntry {
  id          String               @id @db.Uuid
  scopeType   LeaderboardScopeType @map("scope_type")
  scopeId     String               @map("scope_id") @db.Uuid
  subjectType SubjectType          @map("subject_type")
  subjectId   String               @map("subject_id") @db.Uuid
  displayName String               @map("display_name")
  score       Decimal              @db.Decimal(12, 2)
  tiebreakAt  DateTime             @map("tiebreak_at") @db.Timestamptz(6)
  rank        Int
  computedAt  DateTime             @default(now()) @map("computed_at") @db.Timestamptz(6)

  @@unique([scopeType, scopeId, subjectType, subjectId])
  @@index([scopeType, scopeId, score(sort: Desc), tiebreakAt(sort: Asc)])
  @@map("leaderboard_entries")
}

// ---------------------------------------------------------------------------
// Prérequis et parcours pédagogique (US5, US6)
// ---------------------------------------------------------------------------

/// Prérequis d'un défi (FR-023, FR-024).
/// Une des quatre conditions doit être renseignée de façon exclusive (contrôlé par CHECK SQL).
model ChallengePrerequisite {
  id                    String   @id @db.Uuid
  challengeId           String   @map("challenge_id") @db.Uuid
  requiredChallengeId   String?  @map("required_challenge_id") @db.Uuid
  requiredLevel         Int?     @map("required_level")
  requiredLessonId      String?  @map("required_lesson_id") @db.Uuid
  requiredLoreChapterId String?  @map("required_lore_chapter_id") @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  challenge           Challenge    @relation("ChallengePrerequisites", fields: [challengeId], references: [id], onDelete: Cascade)
  requiredChallenge   Challenge?   @relation("ChallengePrerequisiteRequirements", fields: [requiredChallengeId], references: [id], onDelete: Cascade)
  requiredLesson      Lesson?      @relation(fields: [requiredLessonId], references: [id], onDelete: Cascade)
  requiredLoreChapter LoreChapter? @relation(fields: [requiredLoreChapterId], references: [id], onDelete: Cascade)

  @@index([challengeId])
  @@index([requiredChallengeId])
  @@index([requiredLessonId])
  @@index([requiredLoreChapterId])
  @@map("challenge_prerequisites")
}

/// Leçon d'un parcours thématique (FR-023, US6).
model Lesson {
  id               String   @id @db.Uuid
  themeId          String   @map("theme_id") @db.Uuid
  slug             String   @unique
  title            String
  contentMd        String   @map("content_md")
  order            Int      @default(0)
  positioningTest  Json?    @map("positioning_test")
  estimatedMinutes Int      @default(15) @map("estimated_minutes")
  status           String   @default("draft")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  theme         Theme                   @relation(fields: [themeId], references: [id], onDelete: Restrict)
  progress      LessonProgress[]
  prerequisites ChallengePrerequisite[]

  @@index([themeId])
  @@map("lessons")
}

/// Progression d'un utilisateur sur une leçon (US6).
model LessonProgress {
  userId      String    @map("user_id") @db.Uuid
  lessonId    String    @map("lesson_id") @db.Uuid
  status      String    @default("not_started") // not_started | in_progress | completed
  quizScore   Int?      @map("quiz_score")
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([userId, lessonId])
  @@map("lesson_progress")
}

/// Chapitre de l'histoire/lore (FR-023, US14).
model LoreChapter {
  id            String   @id @db.Uuid
  slug          String   @unique
  title         String
  contentMd     String   @map("content_md")
  requiredLevel Int      @default(1) @map("required_level")
  order         Int      @default(0)
  audioKey      String?  @map("audio_key")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  progress      LoreProgress[]
  bosses        Boss[]
  prerequisites ChallengePrerequisite[]

  @@map("lore_chapters")
}

/// Progression de l'utilisateur dans le lore.
model LoreProgress {
  userId     String    @map("user_id") @db.Uuid
  chapterId  String    @map("chapter_id") @db.Uuid
  unlockedAt DateTime  @default(now()) @map("unlocked_at") @db.Timestamptz(6)
  readAt     DateTime? @map("read_at") @db.Timestamptz(6)

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter LoreChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@id([userId, chapterId])
  @@map("lore_progress")
}

// ---------------------------------------------------------------------------
// Équipes et collaboration (US8)
// ---------------------------------------------------------------------------

/// Équipe de 2 à 5 joueurs (FR-055, FR-056). Le nom et le tag sont uniques
/// (insensibles à la casse, `citext`). La dissolution est logique
/// (`disbandedAt`) afin de conserver les scores déjà acquis (FR-060).
model Team {
  id          String    @id @db.Uuid
  name        String    @unique @db.Citext
  tag         String    @unique @db.Citext
  description String?
  logoKey     String?   @map("logo_key")
  /// Nullable pour autoriser la suppression d'un capitaine sans remplaçant
  /// (FR-014 : l'équipe est alors dissoute par `account-deletion.service.ts`).
  captainId   String?   @map("captain_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  disbandedAt DateTime? @map("disbanded_at") @db.Timestamptz(6)

  captain             User?                    @relation("TeamCaptain", fields: [captainId], references: [id], onDelete: SetNull)
  members             TeamMember[]
  invitations         TeamInvitation[]
  officialSubmissions TeamOfficialSubmission[]
  collaborativeDocuments CollaborativeDocument[]
  contributionEvents      ContributionEvent[]
  contributionScores      ContributionScore[]

  @@index([disbandedAt])
  @@map("teams")
}

/// Appartenance à une équipe. `leftAt` marque un départ logique : un joueur
/// ne peut avoir qu'un seul engagement actif (index partiel UNIQUE
/// `(user_id) WHERE left_at IS NULL`, exprimé dans la migration SQL car
/// Prisma ne sait pas modéliser un index partiel).
model TeamMember {
  id       String         @id @db.Uuid
  teamId   String         @map("team_id") @db.Uuid
  userId   String         @map("user_id") @db.Uuid
  role     TeamMemberRole @default(member)
  joinedAt DateTime       @default(now()) @map("joined_at") @db.Timestamptz(6)
  leftAt   DateTime?      @map("left_at") @db.Timestamptz(6)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([teamId, leftAt])
  @@index([userId, leftAt])
  @@map("team_members")
}

/// Invitation par lien nu ou destinataire d'un pseudo (FR-055). Seul le hash
/// du jeton est conservé ; le jeton en clair n'est renvoyé qu'une fois.
model TeamInvitation {
  id               String    @id @db.Uuid
  teamId           String    @map("team_id") @db.Uuid
  tokenHash        String    @unique @map("token_hash")
  invitedUserId    String?   @map("invited_user_id") @db.Uuid
  invitedPseudonym String?   @map("invited_pseudonym") @db.Citext
  createdBy        String?   @map("created_by") @db.Uuid
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt       DateTime? @map("accepted_at") @db.Timestamptz(6)
  declinedAt       DateTime? @map("declined_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  team        Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  invitedUser User? @relation("TeamInvitationInvitedUser", fields: [invitedUserId], references: [id], onDelete: SetNull)
  creator     User? @relation("TeamInvitationCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([teamId, expiresAt])
  @@map("team_invitations")
}

/// Désignation unique d'une soumission officielle par équipe et par défi
/// (FR-046, clarification 1). `@@unique` garantit que le dernier désigné
/// remplace le précédent, sans agrégation des scores individuels.
model TeamOfficialSubmission {
  id           String   @id @db.Uuid
  teamId       String   @map("team_id") @db.Uuid
  challengeId  String   @map("challenge_id") @db.Uuid
  submissionId String   @map("submission_id") @db.Uuid
  designatedBy String?  @map("designated_by") @db.Uuid
  designatedAt DateTime @default(now()) @map("designated_at") @db.Timestamptz(6)

  team       Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  challenge  Challenge  @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  submission Submission @relation("OfficialTeamSubmission", fields: [submissionId], references: [id], onDelete: Cascade)
  designator User?      @relation("OfficialSubmissionDesignator", fields: [designatedBy], references: [id], onDelete: SetNull)

  @@unique([teamId, challengeId])
  @@map("team_official_submissions")
}

/// Document Yjs persisté pour une équipe sur un défi (FR-057). `state` est
/// l'état encodé par `Y.encodeStateAsUpdate` : la compaction consiste à
/// remplacer ce blob à chaque flush, sans journal de deltas. Aucun `userId`
/// n'y figure : la purge RGPD (FR-013) n'a donc rien à anonymiser ici.
model CollaborativeDocument {
  id          String   @id @db.Uuid
  teamId      String   @map("team_id") @db.Uuid
  challengeId String   @map("challenge_id") @db.Uuid
  state       Bytes
  version     Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([teamId, challengeId])
  @@map("collaborative_documents")
}

/// Événements de contribution individuelle (FR-059). Sources : lignes conservées
/// d'une soumission, réussites retenues, assistance apportée aux coéquipiers.
model ContributionEvent {
  id           String                @id @db.Uuid
  teamId       String                @map("team_id") @db.Uuid
  challengeId  String                @map("challenge_id") @db.Uuid
  userId       String                @map("user_id") @db.Uuid
  kind         ContributionEventKind
  weight       Int                   @default(1)
  submissionId String?               @map("submission_id") @db.Uuid
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  team       Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  challenge  Challenge   @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  submission Submission? @relation("ContributionSubmission", fields: [submissionId], references: [id], onDelete: SetNull)

  @@index([teamId, userId])
  @@index([challengeId, userId])
  @@map("contribution_events")
}

/// Score de contribution agrégé, avec le coefficient réduit appliqué au
/// classement des joueurs (FR-059). Recalculé à chaque nouvel événement.
model ContributionScore {
  teamId      String   @map("team_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  keptLines   Int      @default(0) @map("kept_lines")
  successes   Int      @default(0)
  assistance  Int      @default(0)
  coefficient Decimal  @default(0.5) @db.Decimal(3, 2)
  score       Int      @default(0)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@map("contribution_scores")
}

// ---------------------------------------------------------------------------
// Événements à essai unique (US9)
// ---------------------------------------------------------------------------

/// Événement planifié (FR-061 à FR-065). Les contraintes `ends_at > starts_at`,
/// `max_attempts = 1` et la validité IANA de `timezone` sont vérifiées côté API
/// et dans la migration SQL (CHECK pour les deux premières).
model Event {
  id               String       @id @db.Uuid
  slug             String       @unique
  title            String
  timezone         String
  startsAt         DateTime     @map("starts_at") @db.Timestamptz(6)
  endsAt           DateTime     @map("ends_at") @db.Timestamptz(6)
  status           EventStatus  @default(draft)
  type             EventType    @default(standard)
  maxAttempts      Int          @default(1) @map("max_attempts")
  minParticipants  Int          @default(8) @map("min_participants")
  eliminationRule  Json         @default("{\"threshold\":50,\"percent\":10}") @map("elimination_rule")
  rewards          Json?
  createdBy        String?      @map("created_by") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  creator     User?              @relation("EventCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  challenges  EventChallenge[]
  participants EventParticipant[]
  submissions Submission[]

  @@index([status, startsAt])
  @@map("events")
}

/// Défi associé à un événement, dans l'ordre du parcours (data-model.md §5).
model EventChallenge {
  eventId     String @map("event_id") @db.Uuid
  challengeId String @map("challenge_id") @db.Uuid
  order       Int

  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@id([eventId, challengeId])
  @@index([eventId, order])
  @@map("event_challenges")
}

/// Participation d'un joueur (ou d'une équipe) à un événement. L'essai n'est
/// consommé qu'au démarrage explicite ; le job d'expiration le consomme aussi
/// à la fin de la fenêtre en cas d'abandon ou de fermeture du navigateur.
model EventParticipant {
  id                String      @id @db.Uuid
  eventId           String      @map("event_id") @db.Uuid
  subjectType       SubjectType @map("subject_type")
  subjectId         String      @map("subject_id") @db.Uuid
  registeredAt      DateTime    @default(now()) @map("registered_at") @db.Timestamptz(6)
  attemptStartedAt  DateTime?   @map("attempt_started_at") @db.Timestamptz(6)
  attemptConsumedAt DateTime?   @map("attempt_consumed_at") @db.Timestamptz(6)
  eliminatedAt      DateTime?   @map("eliminated_at") @db.Timestamptz(6)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, subjectType, subjectId])
  @@index([eventId, eliminatedAt])
  @@map("event_participants")
}

/// Boss de fin de chapitre (US10, FR-066). La somme des `hp_share` de ses
/// phases doit valoir 100 ; elle est vérifiée à la création par l'API et
/// documentée dans `data-model.md` (aucun CHECK SQL inter-lignes équivalent).
model Boss {
  id            String   @id @db.Uuid
  slug          String   @unique
  name          String
  loreChapterId String   @map("lore_chapter_id") @db.Uuid
  maxHp         Int      @map("max_hp")
  rewards       Json?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  chapter     LoreChapter      @relation(fields: [loreChapterId], references: [id], onDelete: Restrict)
  phases      BossPhase[]
  engagements BossEngagement[]

  @@map("bosses")
}

/// Phase ordonnée d'un boss : sous-défi, part de la barre et règle de dégâts
/// `{"per_100_score": 5, "failureCost": 15}` (FR-066, FR-070).
model BossPhase {
  id          String  @id @db.Uuid
  bossId      String  @map("boss_id") @db.Uuid
  order       Int
  challengeId String  @map("challenge_id") @db.Uuid
  hpShare     Decimal @map("hp_share") @db.Decimal(5, 2)
  damageRule  Json    @map("damage_rule")

  boss        Boss         @relation(fields: [bossId], references: [id], onDelete: Cascade)
  challenge   Challenge    @relation(fields: [challengeId], references: [id], onDelete: Restrict)
  submissions Submission[]

  @@unique([bossId, order])
  @@index([bossId, order])
  @@map("boss_phases")
}

/// PV d'un joueur ou d'un pool d'équipe. La régénération est calculée à la
/// lecture puis matérialisée (FR-067, FR-069) ; le CHECK `0 <= hp <= max_hp`
/// est porté par la migration SQL.
model PlayerHealth {
  id          String      @id @db.Uuid
  subjectType SubjectType @map("subject_type")
  subjectId   String      @map("subject_id") @db.Uuid
  hp          Int         @default(100)
  maxHp       Int         @default(100) @map("max_hp")
  koUntil     DateTime?   @map("ko_until") @db.Timestamptz(6)
  lastRegenAt DateTime    @map("last_regen_at") @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([subjectType, subjectId])
  @@map("player_health")
}

/// Progression d'un joueur (ou d'une équipe) sur un boss. L'unicité garantit
/// qu'une victoire n'est attribuée qu'une seule fois (FR-070).
model BossEngagement {
  id              String      @id @db.Uuid
  bossId          String      @map("boss_id") @db.Uuid
  subjectType     SubjectType @map("subject_type")
  subjectId       String      @map("subject_id") @db.Uuid
  bossHpRemaining Int?        @map("boss_hp_remaining")
  phaseReached    Int         @default(1) @map("phase_reached")
  defeatedAt      DateTime?   @map("defeated_at") @db.Timestamptz(6)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  boss Boss @relation(fields: [bossId], references: [id], onDelete: Cascade)

  @@unique([bossId, subjectType, subjectId])
  @@index([subjectType, subjectId])
  @@map("boss_engagements")
}

// ---------------------------------------------------------------------------
// Économie (US11, FR-072 à FR-077)
// ---------------------------------------------------------------------------

/// Portefeuille d'un joueur. Le solde est un cache transactionnel du registre :
/// sa source de vérité reste `SUM(transactions.amount)` (SC-021).
model Wallet {
  id        String   @id @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@map("wallets")
}

/// Registre append-only : UPDATE et DELETE sont refusés par trigger SQL.
model Transaction {
  id             String            @id @db.Uuid
  walletId       String            @map("wallet_id") @db.Uuid
  amount         Int
  reason         TransactionReason
  referenceType  String?           @map("reference_type")
  referenceId    String?           @map("reference_id") @db.Uuid
  idempotencyKey String            @unique @map("idempotency_key")
  balanceAfter   Int               @map("balance_after")
  createdBy      String?           @map("created_by") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  wallet        Wallet          @relation(fields: [walletId], references: [id], onDelete: Restrict)
  creator       User?           @relation("TransactionCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  hintPurchases HintPurchase[]

  @@index([walletId, createdAt])
  @@map("transactions")
}

/// Catalogue de la boutique. `metadata` porte par exemple `{ "hint_id": ... }`
/// ou `{ "hp_restore": 50 }` (§7 data-model).
model ShopItem {
  id            String        @id @db.Uuid
  sku           String        @unique
  name          String
  kind          ShopItemKind
  priceBits     Int           @map("price_bits")
  isActive      Boolean       @default(true) @map("is_active")
  metadata      Json          @default("{}")
  availableFrom DateTime?     @map("available_from") @db.Timestamptz(6)
  availableUntil DateTime?    @map("available_until") @db.Timestamptz(6)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  inventory Inventory[]

  @@index([kind, isActive])
  @@map("shop_items")
}

/// Objets possédés par un joueur (quantité et état d'équipement).
model Inventory {
  id         String   @id @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  shopItemId String   @map("shop_item_id") @db.Uuid
  quantity   Int      @default(1)
  equipped   Boolean  @default(false)
  acquiredAt DateTime @default(now()) @map("acquired_at") @db.Timestamptz(6)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopItem ShopItem @relation(fields: [shopItemId], references: [id], onDelete: Restrict)

  @@unique([userId, shopItemId])
  @@index([userId])
  @@map("inventory")
}

/// Indice rédigé par l'auteur, jamais dérivé des tests chiffrés (FR-042).
model ChallengeHint {
  id          String @id @db.Uuid
  challengeId String @map("challenge_id") @db.Uuid
  order       Int
  content     String
  priceBits   Int    @map("price_bits")

  challenge Challenge       @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  purchases HintPurchase[]

  @@unique([challengeId, order])
  @@index([challengeId, order])
  @@map("challenge_hints")
}

/// Achat d'un indice : unicité `(user_id, hint_id)` et transaction liée.
model HintPurchase {
  id            String   @id @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  challengeId   String   @map("challenge_id") @db.Uuid
  hintId        String   @map("hint_id") @db.Uuid
  transactionId String   @map("transaction_id") @db.Uuid
  purchasedAt   DateTime @default(now()) @map("purchased_at") @db.Timestamptz(6)

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge   Challenge     @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  hint        ChallengeHint @relation(fields: [hintId], references: [id], onDelete: Restrict)
  transaction Transaction   @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@unique([userId, hintId])
  @@index([userId, challengeId])
  @@map("hint_purchases")
}

/// Succès configurés par clé, avec critères évalués côté serveur (FR-077).
model Badge {
  id          String   @id @db.Uuid
  key         String   @unique
  name        String
  description String
  criteria    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  users UserBadge[]

  @@map("badges")
}

/// Attribution unique d'un badge à un joueur.
model UserBadge {
  userId    String   @map("user_id") @db.Uuid
  badgeId   String   @map("badge_id") @db.Uuid
  awardedAt DateTime @default(now()) @map("awarded_at") @db.Timestamptz(6)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Restrict)

  @@id([userId, badgeId])
  @@index([badgeId])
  @@map("user_badges")
}
