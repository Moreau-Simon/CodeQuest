{
  "name": "codequest",
  "version": "0.1.0",
  "private": true,
  "description": "Plateforme CodeQuest — défis informatiques et compétition",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "pnpm --filter @codequest/api test:integration",
    "e2e": "pnpm --filter @codequest/web e2e",
    "test:a11y": "pnpm --filter @codequest/web test:a11y",
    "test:browsers": "pnpm --filter @codequest/web exec playwright test",
    "security:zap": "docker run --rm -v \"$PWD:/zap/wrk\" ghcr.io/zaproxy/zaproxy:stable zap-baseline.py -t http://localhost:8080",
    "ops:backup": "bash infra/backup/backup.sh",
    "ops:restore": "bash infra/backup/restore.sh",
    "ops:verify-integrity": "pnpm --filter @codequest/api exec ts-node --transpile-only src/ops/verify-integrity.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,html}": [
      "prettier --write"
    ]
  }
}
