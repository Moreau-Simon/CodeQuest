# Configuration d'exemple — valeurs factices uniquement (T248 / FR-111).
# Copier vers `.env` puis remplacer chaque `changez-moi` / `placeholder` par une valeur locale secrète.
# Ne jamais committer un `.env` réel : seul ce fichier est versionné.

NODE_ENV=development
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173

POSTGRES_USER=example
POSTGRES_PASSWORD=example
POSTGRES_DB=codequest
POSTGRES_PORT=5432
DATABASE_URL=postgresql://example:example@localhost:5432/codequest?schema=public

REDIS_URL=redis://localhost:6379
REDIS_PREFIX=codequest

SESSION_SECRET=changez-moi-avec-une-chaine-aleatoire-d-au-moins-32-caracteres
JWT_SECRET=changez-moi-avec-une-chaine-aleatoire-d-au-moins-32-caracteres
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

AES_KEY_BASE64=placeholder-base64-d-une-cle-aes-256
AES_KEY_ID=v1

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=example
MINIO_SECRET_KEY=placeholder
MINIO_BUCKET_ASSETS=codequest-assets
MINIO_BUCKET_AVATARS=codequest-avatars
MINIO_BUCKET_SECRETS=codequest-secrets

ASSETS_SEED_KEY=dev-seed-key-a-remplacer
ASSETS_SERVICE_URL=http://localhost:8001

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=example
SMTP_PASSWORD=placeholder
SMTP_FROM=CodeQuest <no-reply@example.local>

LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=example
LIVEKIT_API_SECRET=dev-secret-a-remplacer
LIVEKIT_TOKEN_TTL_SECONDS=60

VAPID_PUBLIC_KEY=placeholder
VAPID_PRIVATE_KEY=placeholder
VAPID_SUBJECT=mailto:no-reply@example.local

LOG_LEVEL=info
METRICS_PORT=9464
